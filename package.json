{
  "name": "motel-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter \"*\" dev",
    "build": "bun --filter \"*\" build",
    "test": "bun --filter \"*\" test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun test",
    "db:generate": "bun --filter @motel/db generate",
    "db:migrate": "bun --filter @motel/db migrate",
    "db:seed": "bun --filter @motel/db seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@electric-sql/pglite": "^0.5.8",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "typescript": "^5.7.3"
  }
}
